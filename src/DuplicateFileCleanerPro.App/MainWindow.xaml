<Window
    x:Class="DuplicateFileCleanerPro.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cleanup="using:DuplicateFileCleanerPro.App.Cleanup"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:results="using:DuplicateFileCleanerPro.App.Results">
  <controls:NavigationView x:Name="ShellNavigation" PaneDisplayMode="Left" OpenPaneLength="224" CompactPaneLength="48" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <controls:NavigationView.MenuItems>
      <controls:NavigationViewItem x:Name="ScanNavigationItem" x:Uid="ScanNavigationItem" Icon="Find" IsSelected="True" MinHeight="40" Padding="12,0" />
      <controls:NavigationViewItem x:Name="ResultsNavigationItem" x:Uid="ResultsNavigationItem" Icon="Bullets" IsEnabled="False" MinHeight="40" Padding="12,0" />
      <controls:NavigationViewItem x:Name="SettingsNavigationItem" x:Uid="SettingsNavigationItem" Icon="Setting" MinHeight="40" Padding="12,0" />
    </controls:NavigationView.MenuItems>
    <Grid Padding="{StaticResource PagePadding}">
      <ScrollViewer x:Name="ScanScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid>
          <StackPanel x:Name="ScanPage" MaxWidth="1000">
            <Grid ColumnSpacing="20" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock x:Uid="ScanSetupTitle" Style="{StaticResource PageTitleTextStyle}" /><TextBlock x:Uid="ScanSetupDescription" Opacity="0.7" /></StackPanel><Button x:Name="StartScanButton" x:Uid="StartScanButton" Grid.Column="1" VerticalAlignment="Center" Click="OnStartScanClick" /></Grid>
            <TextBlock x:Uid="ScanLocationsTitle" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8" />
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="16,12"><StackPanel Spacing="10"><TextBlock x:Name="ScanLocationsEmptyText" x:Uid="ScanLocationsEmpty" Opacity="0.7" /><ListView x:Name="LocationsList" SelectionMode="None" Visibility="Collapsed"><ListView.ItemTemplate><DataTemplate><Grid Padding="0,7" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8B7;" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding NormalizedPath}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding NormalizedPath}" /></StackPanel><Button Grid.Column="2" x:Uid="RemoveFolderButton" Tag="{Binding}" Click="OnRemoveFolderClick" /></Grid></DataTemplate></ListView.ItemTemplate></ListView><Button x:Uid="AddFolderButton" HorizontalAlignment="Left" Click="OnAddFolderClick" /></StackPanel></Border>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="16,14" Margin="0,16,0,0"><StackPanel Spacing="5"><TextBlock x:Uid="ReviewTitle" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock x:Name="ReviewSummaryText" x:Uid="ReviewDescription" Opacity="0.75" TextWrapping="Wrap" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="ScanningPage" Visibility="Collapsed" MaxWidth="1000"><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock x:Name="ScanStageTitle" x:Uid="ScanningTitle" Style="{StaticResource PageTitleTextStyle}" /><TextBlock x:Name="ScanStageDescription" x:Uid="ScanningDescription" Opacity="0.7" /></StackPanel><Button x:Name="CancelScanButton" x:Uid="CancelScanButton" Grid.Column="1" VerticalAlignment="Center" Click="OnCancelScanClick" /></Grid><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="18,16"><StackPanel Spacing="12"><ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True" Height="6" /><TextBlock x:Name="CurrentActivityText" x:Uid="ScanningWaiting" TextTrimming="CharacterEllipsis" /><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Uid="MetricFiles" Opacity="0.65" FontSize="12" /><TextBlock x:Name="FilesMetricText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Uid="MetricAnalyzed" Opacity="0.65" FontSize="12" /><TextBlock x:Name="AnalyzedMetricText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Uid="MetricGroups" Opacity="0.65" FontSize="12" /><TextBlock x:Name="GroupsMetricText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Uid="MetricElapsed" Opacity="0.65" FontSize="12" /><TextBlock x:Name="ElapsedMetricText" FontWeight="SemiBold" /></StackPanel></Grid></StackPanel></Border></StackPanel>
          <StackPanel x:Name="SettingsPage" Visibility="Collapsed" MaxWidth="880" Spacing="0">
            <TextBlock x:Uid="SettingsTitle" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Uid="SettingsDescription" Opacity="0.7" Margin="0,5,0,18" />
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,15"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Uid="SettingsAppearanceTitle" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock x:Uid="SettingsAppearanceDescription" Opacity="0.7" TextWrapping="Wrap" /></StackPanel><ComboBox x:Name="AppearanceComboBox" x:Uid="AppearanceComboBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="OnAppearanceSelectionChanged"><ComboBoxItem x:Uid="AppearanceSystem" Tag="System" /><ComboBoxItem x:Uid="AppearanceLight" Tag="Light" /><ComboBoxItem x:Uid="AppearanceDark" Tag="Dark" /></ComboBox></Grid></Border>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,15"><StackPanel Spacing="5"><TextBlock x:Uid="SettingsPrivacyTitle" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock x:Uid="SettingsPrivacyDescription" Opacity="0.7" TextWrapping="Wrap" /><TextBlock x:Uid="SettingsPrivacyStorage" Opacity="0.7" TextWrapping="Wrap" /></StackPanel></Border>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,15"><StackPanel Spacing="5"><TextBlock x:Uid="SettingsSafetyTitle" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock x:Uid="SettingsSafetyDescription" Opacity="0.7" TextWrapping="Wrap" /></StackPanel></Border>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Uid="SettingsAboutTitle" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock x:Uid="SettingsAboutDescription" Opacity="0.7" /></StackPanel><TextBlock x:Name="AppVersionText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.7" /></Grid></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Grid x:Name="ResultsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="16" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Uid="ResultsTitle" Style="{StaticResource PageTitleTextStyle}" /><TextBlock x:Uid="ResultsDescription" Opacity="0.7" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="ReviewCleanupButton" x:Uid="ReviewCleanupButton" VerticalAlignment="Center" Click="OnReviewCleanupClick" IsEnabled="False" /><Button x:Uid="ResultsNewScanButton" VerticalAlignment="Center" Click="OnNewScanClick" /></StackPanel></Grid>
        <InfoBar x:Name="ResultsStaleNotice" Grid.Row="1" x:Uid="ResultsStaleNotice" IsOpen="False" IsClosable="False" Severity="Informational" Margin="0,0,0,12" />
        <Grid Grid.Row="2" ColumnSpacing="24" Padding="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Uid="ResultsGroupsLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="ResultGroupsText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Uid="ResultsFilesLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="ResultFilesText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Uid="ResultsReclaimableLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="ResultReclaimableText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Uid="ResultsCandidatesLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="ResultCandidatesText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="4" HorizontalAlignment="Right"><TextBlock x:Uid="ResultsSkippedLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="ResultSkippedText" FontWeight="SemiBold" HorizontalAlignment="Right" /></StackPanel></Grid>
        <Grid Grid.Row="3" ColumnSpacing="8" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><AutoSuggestBox x:Name="ResultsSearchBox" x:Uid="ResultsSearchBox" TextChanged="OnResultsSearchTextChanged" QueryIcon="Find" /><ComboBox x:Name="ResultsSortComboBox" x:Uid="ResultsSortComboBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnResultsSortChanged"><ComboBoxItem x:Uid="ResultsSortReclaimable" Tag="ReclaimableBytes" /><ComboBoxItem x:Uid="ResultsSortFileSize" Tag="FileSize" /><ComboBoxItem x:Uid="ResultsSortCopies" Tag="CopyCount" /><ComboBoxItem x:Uid="ResultsSortName" Tag="Name" /><ComboBoxItem x:Uid="ResultsSortPath" Tag="Path" /></ComboBox><Button x:Name="ResultsDirectionButton" x:Uid="ResultsDescendingButton" Grid.Column="2" Click="OnResultsDirectionClick" /><ComboBox x:Name="ResultsFilterComboBox" x:Uid="ResultsFilterComboBox" Grid.Column="3" SelectedIndex="0" SelectionChanged="OnResultsFilterChanged"><ComboBoxItem x:Uid="ResultsFilterAll" Tag="AllGroups" /><ComboBoxItem x:Uid="ResultsFilterSelected" Tag="SelectedGroups" /></ComboBox><StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button x:Uid="ExpandAllButton" Click="OnExpandAllClick" /><Button x:Uid="CollapseAllButton" Click="OnCollapseAllClick" /></StackPanel></Grid>
        <Grid Grid.Row="4"><ListView x:Name="ResultsGroupsList" x:Uid="ResultsGroupsList" ItemsSource="{Binding VisibleGroups}" SelectionMode="None" HorizontalContentAlignment="Stretch"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel /></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemTemplate><DataTemplate x:DataType="results:ResultGroupViewModel"><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10"><controls:Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch"><controls:Expander.Header><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Representative.File.NormalizedPath}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Representative.File.NormalizedPath}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Uid="GroupCopiesLabel" FontSize="12" Opacity="0.65" /><TextBlock Text="{Binding Members.Count}" HorizontalAlignment="Right" /></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Uid="GroupSizeLabel" FontSize="12" Opacity="0.65" /><TextBlock Text="{Binding FileSize, Converter={StaticResource ByteSizeConverter}}" HorizontalAlignment="Right" /></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Uid="GroupReclaimableLabel" FontSize="12" Opacity="0.65" /><TextBlock Text="{Binding ReclaimableBytes, Converter={StaticResource ByteSizeConverter}}" FontWeight="SemiBold" HorizontalAlignment="Right" /></StackPanel></Grid></controls:Expander.Header><ListView x:Uid="ResultsMembersList" ItemsSource="{Binding Members}" SelectionMode="None" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate x:DataType="results:ResultMemberViewModel"><Grid Padding="32,8,4,8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><CheckBox x:Uid="ResultsCandidateCheckBox" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding File.FileName}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding File.NormalizedPath}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding File.NormalizedPath}" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding File.Length, Converter={StaticResource ByteSizeConverter}}" VerticalAlignment="Center" Opacity="0.8" /><TextBlock Grid.Column="3" Text="{Binding File.LastWriteTimeUtc, Converter={StaticResource DateTimeConverter}}" VerticalAlignment="Center" FontSize="12" Opacity="0.65" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></controls:Expander></Border></DataTemplate></ListView.ItemTemplate></ListView><StackPanel x:Name="ResultsEmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Visibility="Collapsed"><TextBlock x:Name="ResultsEmptyTitle" Style="{StaticResource SectionTitleTextStyle}" HorizontalAlignment="Center" /><TextBlock x:Name="ResultsEmptyDescription" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Grid>
      </Grid>

      <Grid x:Name="CleanupPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="16" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Name="CleanupPageTitle" Style="{StaticResource PageTitleTextStyle}" /><TextBlock x:Name="CleanupPageDescription" Opacity="0.7" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="CleanupBackButton" x:Uid="CleanupBackButton" VerticalAlignment="Center" Click="OnCleanupBackClick" /><Button x:Name="CleanupRescanButton" x:Uid="CleanupRescanButton" VerticalAlignment="Center" Click="OnCleanupRescanClick" Visibility="Collapsed" /></StackPanel></Grid>
        <Grid Grid.Row="1">
          <StackPanel x:Name="CleanupReviewPanel" MaxWidth="1000" Spacing="16">
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="18,16"><StackPanel Spacing="8"><TextBlock x:Uid="CleanupReviewSummaryTitle" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock x:Name="CleanupReviewSummaryText" TextWrapping="Wrap" Opacity="0.8" /><Grid ColumnSpacing="28" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Uid="CleanupCandidateFilesLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="CleanupCandidateFilesText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Uid="CleanupCandidateSpaceLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="CleanupCandidateSpaceText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Uid="CleanupAffectedGroupsLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="CleanupAffectedGroupsText" FontWeight="SemiBold" /></StackPanel></Grid></StackPanel></Border>
            <TextBlock x:Uid="CleanupReviewListTitle" Style="{StaticResource SectionTitleTextStyle}" />
            <ListView x:Name="CleanupReviewList" x:Uid="CleanupReviewList" SelectionMode="None" HorizontalContentAlignment="Stretch" MaxHeight="360"><ListView.ItemTemplate><DataTemplate x:DataType="cleanup:CleanupReviewCandidate"><Grid Padding="4,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding GroupNumber}" VerticalAlignment="Center" Opacity="0.65" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding File.FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding File.NormalizedPath}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding File.NormalizedPath}" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding File.Length, Converter={StaticResource ByteSizeConverter}}" VerticalAlignment="Center" Opacity="0.8" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
            <InfoBar x:Uid="CleanupRecycleBinNotice" IsOpen="True" IsClosable="False" Severity="Informational" />
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="CleanupChangeSelectionButton" Click="OnCleanupBackClick" /><Button x:Name="ConfirmCleanupButton" x:Uid="ConfirmCleanupButton" Click="OnConfirmCleanupClick" /></StackPanel>
          </StackPanel>
          <StackPanel x:Name="CleanupProgressPanel" Visibility="Collapsed" MaxWidth="1000" Spacing="16"><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="18,16"><StackPanel Spacing="14"><ProgressBar x:Name="CleanupProgressBar" Height="6" Minimum="0" /><TextBlock x:Name="CleanupActivityText" x:Uid="CleanupPreparing" TextTrimming="CharacterEllipsis" /><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Uid="CleanupProcessedLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="CleanupProcessedText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Uid="CleanupMovedLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="CleanupMovedText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Uid="CleanupSkippedLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="CleanupSkippedText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Uid="CleanupReclaimedLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="CleanupReclaimedText" FontWeight="SemiBold" /></StackPanel></Grid><Button x:Name="CancelCleanupButton" x:Uid="CancelCleanupButton" HorizontalAlignment="Left" Click="OnCancelCleanupClick" /></StackPanel></Border></StackPanel>
          <StackPanel x:Name="CleanupCompletionPanel" Visibility="Collapsed" MaxWidth="1000" Spacing="16"><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="18,16"><StackPanel Spacing="8"><TextBlock x:Name="CleanupCompletionTitle" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock x:Name="CleanupCompletionSummary" TextWrapping="Wrap" Opacity="0.8" /><Grid ColumnSpacing="24" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Uid="CleanupMovedLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="CleanupCompletionMovedText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Uid="CleanupReclaimedLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="CleanupCompletionReclaimedText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Uid="CleanupSkippedLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="CleanupCompletionSkippedText" FontWeight="SemiBold" /></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Uid="CleanupFailedLabel" Opacity="0.65" FontSize="12" /><TextBlock x:Name="CleanupCompletionFailedText" FontWeight="SemiBold" /></StackPanel></Grid></StackPanel></Border><TextBlock x:Name="CleanupOutcomesTitle" x:Uid="CleanupOutcomesTitle" Style="{StaticResource SectionTitleTextStyle}" Visibility="Collapsed" /><ListView x:Name="CleanupOutcomeList" x:Uid="CleanupOutcomeList" Visibility="Collapsed" SelectionMode="None" HorizontalContentAlignment="Stretch" MaxHeight="300"><ListView.ItemTemplate><DataTemplate><Grid Padding="4,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Message}" FontSize="12" Opacity="0.78" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Path}" FontSize="12" Opacity="0.58" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Size, Converter={StaticResource ByteSizeConverter}}" VerticalAlignment="Center" Opacity="0.75" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </controls:NavigationView>
</Window>
