<Window
    x:Class="DuplicateFileCleanerPro.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cleanup="using:DuplicateFileCleanerPro.App.Cleanup"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:results="using:DuplicateFileCleanerPro.App.Results">

  <Grid x:Name="WindowRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="36" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border
        x:Name="AppTitleBar"
        Grid.Row="0"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1">
      <Grid Padding="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="20" Height="20" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4">
          <FontIcon FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE8B7;" />
        </Border>
        <TextBlock x:Uid="TitleBarProductName" Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
      </Grid>
    </Border>

    <controls:NavigationView
        x:Name="ShellNavigation"
        Grid.Row="1"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        CompactModeThresholdWidth="760"
        CompactPaneLength="48"
        ExpandedModeThresholdWidth="1040"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        OpenPaneLength="184"
        PaneDisplayMode="Auto">
      <controls:NavigationView.MenuItems>
        <controls:NavigationViewItem x:Name="ScanNavigationItem" x:Uid="ScanNavigationItem" Icon="Find" IsSelected="True" MinHeight="40" Padding="12,0" />
        <controls:NavigationViewItem x:Name="ResultsNavigationItem" x:Uid="ResultsNavigationItem" Icon="Bullets" IsEnabled="False" MinHeight="40" Padding="12,0" />
      </controls:NavigationView.MenuItems>
      <controls:NavigationView.FooterMenuItems>
        <controls:NavigationViewItem x:Name="SettingsNavigationItem" x:Uid="SettingsNavigationItem" Icon="Setting" MinHeight="40" Padding="12,0" />
      </controls:NavigationView.FooterMenuItems>

      <Grid x:Name="PageHost" Padding="{StaticResource PagePadding}">
        <ScrollViewer x:Name="ScanScrollViewer" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid>
            <StackPanel x:Name="ScanPage" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch" Spacing="16">
              <Grid Margin="0,0,0,4" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                  <TextBlock x:Uid="ScanSetupTitle" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" />
                  <TextBlock x:Uid="ScanSetupDescription" Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>
                <Button x:Name="StartScanButton" x:Uid="StartScanButton" Grid.Column="1" MinHeight="40" Padding="18,0" VerticalAlignment="Center" Click="OnStartScanClick" Style="{StaticResource AccentButtonStyle}" />
              </Grid>

              <InfoBar x:Name="ScanSetupNotice" Margin="0,0,0,0" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Severity="Informational" />

              <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid Padding="16,14" ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Spacing="5">
                    <TextBlock x:Uid="ScanProfileTitle" Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Uid="ScanProfileDescription" Style="{StaticResource SecondaryTextStyle}" />
                    <ComboBox x:Name="ProfileComboBox" x:Uid="ProfileComboBox" MinWidth="300" MaxWidth="520" HorizontalAlignment="Left" SelectionChanged="OnProfileSelectionChanged">
                      <ComboBox.ItemTemplate><DataTemplate><StackPanel Padding="0,3" Spacing="1"><TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextStyle}" /><TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveProfileButton" x:Uid="SaveProfileButton" MinHeight="36" Click="OnSaveProfileClick" Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="DeleteProfileButton" x:Uid="DeleteProfileButton" MinHeight="36" Click="OnDeleteProfileClick" Style="{StaticResource ToolbarButtonStyle}" Visibility="Collapsed" />
                  </StackPanel>
                </Grid>
              </Border>

              <Grid x:Name="ScanWorkspaceGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="ScanPrimaryColumn" Width="*" /><ColumnDefinition x:Name="ScanReviewColumn" Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="ScanWorkspaceSecondaryRow" Height="0" /></Grid.RowDefinitions>

                <Border x:Name="ScanLocationsSurface" Style="{StaticResource SurfaceBorderStyle}">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Padding="16,13" ColumnSpacing="10">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <FontIcon VerticalAlignment="Center" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8B7;" />
                      <StackPanel Grid.Column="1" Spacing="1"><TextBlock x:Uid="ScanLocationsTitle" Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" /><TextBlock x:Uid="ScanLocationsDescription" Style="{StaticResource SecondaryTextStyle}" /></StackPanel>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                      <Grid>
                        <StackPanel x:Name="ScanLocationsEmptyPanel" MinHeight="126" Padding="18" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="4">
                          <TextBlock x:Name="ScanLocationsEmptyText" x:Uid="ScanLocationsEmpty" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextStyle}" />
                          <TextBlock x:Uid="ScanEmptyHint" MaxWidth="420" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <ListView x:Name="LocationsList" x:Uid="LocationsList" MaxHeight="286" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource CompactListViewItemStyle}" SelectionMode="None" Visibility="Collapsed">
                          <ListView.ItemTemplate><DataTemplate><Grid MinHeight="64" Padding="16,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="34" Height="34" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="5"><FontIcon FontSize="16" Glyph="{Binding Glyph}" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"><TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextStyle}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TypeAndCapacity}" Style="{StaticResource SecondaryTextStyle}" /><TextBlock Text="{Binding NormalizedPath}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding NormalizedPath}" /></StackPanel><Button x:Uid="RemoveSourceButton" Grid.Column="2" Tag="{Binding}" VerticalAlignment="Center" Click="OnRemoveFolderClick" Style="{StaticResource ToolbarButtonStyle}" /></Grid></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                      </Grid>
                    </Border>
                    <Grid Grid.Row="2" Padding="12,10" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Uid="AddFolderButton" MinHeight="36" Click="OnAddFolderClick" Style="{StaticResource ToolbarButtonStyle}" /><ComboBox x:Name="AvailableDrivesComboBox" x:Uid="AvailableDrivesComboBox" Grid.Column="1" MinHeight="36" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayLabel" /><Button x:Name="AddDriveButton" x:Uid="AddDriveButton" Grid.Column="2" MinHeight="36" Click="OnAddDriveClick" Style="{StaticResource ToolbarButtonStyle}" /></Grid>
                    <Border Grid.Row="3" Padding="16,11" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><ToggleSwitch x:Name="IncludeSubfoldersToggle" x:Uid="IncludeSubfoldersToggle" IsOn="True" Toggled="OnIncludeSubfoldersToggled" /></Border>
                  </Grid>
                </Border>

                <Border x:Name="ScanReviewSurface" Grid.Column="1" Style="{StaticResource SurfaceBorderStyle}">
                  <StackPanel>
                    <Grid Padding="16,13" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE71C;" /><StackPanel Grid.Column="1" Spacing="1"><TextBlock x:Uid="FileCriteriaTitle" Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" /><TextBlock x:Uid="FileCriteriaDescription" Style="{StaticResource SecondaryTextStyle}" /></StackPanel></Grid>
                    <Border Padding="16,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                      <StackPanel Spacing="8">
                        <TextBlock x:Uid="FileTypesLabel" Style="{StaticResource BodyStrongTextStyle}" />
                        <Grid ColumnSpacing="16" RowSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><CheckBox x:Name="DocumentsCheckBox" x:Uid="DocumentsCheckBox" IsChecked="True" Checked="OnFileTypeChanged" Unchecked="OnFileTypeChanged" /><CheckBox x:Name="ImagesCheckBox" x:Uid="ImagesCheckBox" Grid.Column="1" IsChecked="True" Checked="OnFileTypeChanged" Unchecked="OnFileTypeChanged" /><CheckBox x:Name="AudioCheckBox" x:Uid="AudioCheckBox" Grid.Column="2" IsChecked="True" Checked="OnFileTypeChanged" Unchecked="OnFileTypeChanged" /><CheckBox x:Name="VideoCheckBox" x:Uid="VideoCheckBox" Grid.Row="1" IsChecked="True" Checked="OnFileTypeChanged" Unchecked="OnFileTypeChanged" /><CheckBox x:Name="ArchivesCheckBox" x:Uid="ArchivesCheckBox" Grid.Row="1" Grid.Column="1" IsChecked="True" Checked="OnFileTypeChanged" Unchecked="OnFileTypeChanged" /><CheckBox x:Name="OtherCheckBox" x:Uid="OtherCheckBox" Grid.Row="1" Grid.Column="2" IsChecked="True" Checked="OnFileTypeChanged" Unchecked="OnFileTypeChanged" /></Grid>
                        <TextBlock x:Uid="CustomExtensionsLabel" Margin="0,4,0,0" Style="{StaticResource BodyStrongTextStyle}" />
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="CustomExtensionTextBox" x:Uid="CustomExtensionTextBox" MaxLength="32" KeyDown="OnCustomExtensionKeyDown" /><Button x:Uid="AddCustomExtensionButton" Grid.Column="1" MinHeight="36" Click="OnAddCustomExtensionClick" Style="{StaticResource ToolbarButtonStyle}" /></Grid>
                        <ListView x:Name="CustomExtensionsList" x:Uid="CustomExtensionsList" MaxHeight="92" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource CompactListViewItemStyle}" SelectionMode="None" Visibility="Collapsed"><ListView.ItemTemplate><DataTemplate><Grid MinHeight="34" Padding="8,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{Binding}" /><Button x:Uid="RemoveCustomExtensionButton" Grid.Column="1" MinHeight="28" Padding="8,0" Tag="{Binding}" Click="OnRemoveCustomExtensionClick" Style="{StaticResource ToolbarButtonStyle}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                      </StackPanel>
                    </Border>
                    <Border Padding="16,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                      <StackPanel Spacing="8"><TextBlock x:Uid="FileSizeLabel" Style="{StaticResource BodyStrongTextStyle}" /><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><NumberBox x:Name="MinimumSizeNumberBox" x:Uid="MinimumSizeNumberBox" Minimum="0" Maximum="8796093022208" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnSizeCriteriaChanged" /><NumberBox x:Name="MaximumSizeNumberBox" x:Uid="MaximumSizeNumberBox" Grid.Column="1" Minimum="0" Maximum="8796093022208" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnSizeCriteriaChanged" /></Grid><TextBlock x:Uid="FileSizeHint" Style="{StaticResource SecondaryTextStyle}" /></StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </Grid>

              <Border Style="{StaticResource SurfaceBorderStyle}">
                <StackPanel>
                  <Grid Padding="16,13" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE74D;" /><StackPanel Grid.Column="1" Spacing="1"><TextBlock x:Uid="ExclusionsTitle" Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" /><TextBlock x:Uid="ExclusionsDescription" Style="{StaticResource SecondaryTextStyle}" /></StackPanel></Grid>
                  <Grid BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Padding="16,12" Spacing="8"><TextBlock x:Uid="ExcludedFoldersLabel" Style="{StaticResource BodyStrongTextStyle}" /><TextBlock x:Name="ExcludedFoldersEmptyText" x:Uid="ExcludedFoldersEmpty" Style="{StaticResource SecondaryTextStyle}" /><ListView x:Name="ExcludedFoldersList" x:Uid="ExcludedFoldersList" MaxHeight="130" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource CompactListViewItemStyle}" SelectionMode="None" Visibility="Collapsed"><ListView.ItemTemplate><DataTemplate><Grid MinHeight="40" Padding="8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding}" /><Button x:Uid="RemoveExcludedFolderButton" Grid.Column="1" MinHeight="30" Padding="8,0" Tag="{Binding}" Click="OnRemoveExcludedFolderClick" Style="{StaticResource ToolbarButtonStyle}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView><Button x:Uid="AddExcludedFolderButton" MinHeight="36" HorizontalAlignment="Left" Click="OnAddExcludedFolderClick" Style="{StaticResource ToolbarButtonStyle}" /></StackPanel>
                    <StackPanel Grid.Column="1" Padding="16,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Spacing="8"><TextBlock x:Uid="ExcludedExtensionsLabel" Style="{StaticResource BodyStrongTextStyle}" /><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="ExcludedExtensionTextBox" x:Uid="ExcludedExtensionTextBox" MaxLength="32" KeyDown="OnExcludedExtensionKeyDown" /><Button x:Uid="AddExcludedExtensionButton" Grid.Column="1" MinHeight="36" Click="OnAddExcludedExtensionClick" Style="{StaticResource ToolbarButtonStyle}" /></Grid><TextBlock x:Name="ExcludedExtensionsEmptyText" x:Uid="ExcludedExtensionsEmpty" Style="{StaticResource SecondaryTextStyle}" /><ListView x:Name="ExcludedExtensionsList" x:Uid="ExcludedExtensionsList" MaxHeight="92" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource CompactListViewItemStyle}" SelectionMode="None" Visibility="Collapsed"><ListView.ItemTemplate><DataTemplate><Grid MinHeight="34" Padding="8,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{Binding}" /><Button x:Uid="RemoveExcludedExtensionButton" Grid.Column="1" MinHeight="28" Padding="8,0" Tag="{Binding}" Click="OnRemoveExcludedExtensionClick" Style="{StaticResource ToolbarButtonStyle}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Padding="16" Style="{StaticResource SurfaceBorderStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Uid="ReviewTitle" Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" /><TextBlock x:Name="ReviewSummaryText" x:Uid="ReviewDescription" Style="{StaticResource PageSubtitleTextStyle}" /><TextBlock x:Name="CriteriaSummaryText" Style="{StaticResource SecondaryTextStyle}" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3"><TextBlock x:Uid="ReviewMethodTitle" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextStyle}" /><TextBlock x:Uid="ReviewSafetyDescription" MaxWidth="320" TextAlignment="Right" Style="{StaticResource SecondaryTextStyle}" /></StackPanel></Grid>
              </Border>
            </StackPanel>

            <StackPanel x:Name="ScanningPage" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch" Visibility="Collapsed">
              <Grid Margin="0,0,0,20" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="3"><TextBlock x:Uid="ScanningTitle" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" /><TextBlock x:Uid="ScanningDescription" Style="{StaticResource PageSubtitleTextStyle}" /></StackPanel>
                <Button x:Name="CancelScanButton" x:Uid="CancelScanButton" Grid.Column="1" MinHeight="36" Padding="14,0" VerticalAlignment="Center" Click="OnCancelScanClick" Style="{StaticResource ToolbarButtonStyle}" />
              </Grid>
              <Border Padding="20" Style="{StaticResource SurfaceBorderStyle}">
                <StackPanel Spacing="16">
                  <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ProgressRing Width="34" Height="34" IsActive="True" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="ScanStageTitle" x:Uid="ScanningPreparingStage" Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" AutomationProperties.LiveSetting="Polite" /><TextBlock x:Uid="ScanningStageHint" Style="{StaticResource SecondaryTextStyle}" /></StackPanel></Grid>
                  <ProgressBar x:Name="ScanProgressBar" x:Uid="ScanProgressBar" Height="5" IsIndeterminate="True" />
                  <Border Padding="12,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{StaticResource CompactCornerRadius}">
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="15" Glyph="&#xE838;" /><StackPanel Grid.Column="1" Spacing="1"><TextBlock x:Uid="ScanningCurrentActivityLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="CurrentActivityText" x:Uid="ScanningWaiting" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=CurrentActivityText}" /></StackPanel></Grid>
                  </Border>
                  <Grid Padding="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Padding="0,0,14,0"><TextBlock x:Uid="MetricFiles" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="FilesMetricText" Text="0" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <StackPanel Grid.Column="2" Padding="14,0"><TextBlock x:Uid="MetricAnalyzed" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="AnalyzedMetricText" Text="0" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="3" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <StackPanel Grid.Column="4" Padding="14,0"><TextBlock x:Uid="MetricGroups" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="GroupsMetricText" Text="0" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="5" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <StackPanel Grid.Column="6" Padding="14,0,0,0"><TextBlock x:Uid="MetricElapsed" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="ElapsedMetricText" Text="00:00" Style="{StaticResource MetricValueTextStyle}" /></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Grid Margin="2,14,2,0" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE83D;" /><TextBlock x:Uid="ScanLocalPrivacy" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" /></Grid>
            </StackPanel>

            <StackPanel x:Name="SettingsPage" MaxWidth="960" HorizontalAlignment="Stretch" Visibility="Collapsed">
              <TextBlock x:Uid="SettingsTitle" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" />
              <TextBlock x:Uid="SettingsDescription" Margin="0,3,0,20" Style="{StaticResource PageSubtitleTextStyle}" />
              <Border Style="{StaticResource SurfaceBorderStyle}">
                <StackPanel>
                  <Border Style="{StaticResource SettingsRowStyle}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE771;" /><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock x:Uid="SettingsAppearanceTitle" Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" /><TextBlock x:Uid="SettingsAppearanceDescription" Style="{StaticResource SecondaryTextStyle}" /></StackPanel><ComboBox x:Name="AppearanceComboBox" x:Uid="AppearanceComboBox" Grid.Column="2" MinHeight="36" VerticalAlignment="Center" SelectionChanged="OnAppearanceSelectionChanged"><ComboBoxItem x:Uid="AppearanceSystem" Tag="System" /><ComboBoxItem x:Uid="AppearanceLight" Tag="Light" /><ComboBoxItem x:Uid="AppearanceDark" Tag="Dark" /></ComboBox></Grid></Border>
                  <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0,1,0,0"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Top" Margin="0,3,0,0" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE72E;" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Uid="SettingsPrivacyTitle" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock x:Uid="SettingsPrivacyDescription" Style="{StaticResource SecondaryTextStyle}" /><TextBlock x:Uid="SettingsPrivacyStorage" Style="{StaticResource SecondaryTextStyle}" /></StackPanel></Grid></Border>
                  <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0,1,0,0"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Top" Margin="0,3,0,0" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE83D;" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Uid="SettingsSafetyTitle" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock x:Uid="SettingsSafetyDescription" Style="{StaticResource SecondaryTextStyle}" /></StackPanel></Grid></Border>
                  <Border Style="{StaticResource SettingsRowStyle}" BorderThickness="0,1,0,0"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon VerticalAlignment="Center" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE946;" /><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock x:Uid="SettingsAboutTitle" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock x:Uid="SettingsAboutDescription" Style="{StaticResource SecondaryTextStyle}" /></StackPanel><TextBlock x:Name="AppVersionText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" /></Grid></Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <Grid x:Name="ResultsPage" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,14" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Uid="ResultsTitle" Style="{StaticResource PageTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" /><TextBlock x:Uid="ResultsDescription" Style="{StaticResource PageSubtitleTextStyle}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8"><Button x:Name="ReviewCleanupButton" x:Uid="ReviewCleanupButton" MinHeight="36" IsEnabled="False" Click="OnReviewCleanupClick" Style="{StaticResource AccentButtonStyle}" /><Button x:Uid="ResultsNewScanButton" MinHeight="36" Click="OnNewScanClick" Style="{StaticResource ToolbarButtonStyle}" /></StackPanel></Grid>
          <StackPanel Grid.Row="1"><InfoBar x:Name="ResultsStaleNotice" x:Uid="ResultsStaleNotice" Margin="0,0,0,10" IsClosable="False" IsOpen="False" Severity="Informational" /><InfoBar x:Name="ResultsSelectionNotice" x:Uid="ResultsSelectionNotice" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" IsClosable="False" IsOpen="False" Severity="Informational" /></StackPanel>
          <Border Grid.Row="2" Margin="0,0,0,10" Padding="16,12" Style="{StaticResource SurfaceBorderStyle}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Padding="0,0,12,0"><TextBlock x:Uid="ResultsGroupsLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="ResultGroupsText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
              <StackPanel Grid.Column="2" Padding="12,0"><TextBlock x:Uid="ResultsFilesLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="ResultFilesText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="3" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
              <StackPanel Grid.Column="4" Padding="12,0"><TextBlock x:Uid="ResultsReclaimableLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="ResultReclaimableText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="5" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
              <StackPanel Grid.Column="6" Padding="12,0"><TextBlock x:Uid="ResultsCandidatesLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="ResultCandidatesText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="7" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
              <StackPanel Grid.Column="8" Padding="12,0,0,0"><TextBlock x:Uid="ResultsSkippedLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="ResultSkippedText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="3" Margin="0,0,0,10" Style="{StaticResource ToolbarSurfaceStyle}">
            <Grid x:Name="ResultsToolbar"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition x:Name="ResultsToolbarSearchColumn" Width="*" /><ColumnDefinition x:Name="ResultsToolbarSortColumn" Width="Auto" /><ColumnDefinition x:Name="ResultsToolbarDirectionColumn" Width="Auto" /><ColumnDefinition x:Name="ResultsToolbarFilterColumn" Width="0" /><ColumnDefinition x:Name="ResultsToolbarActionsColumn" Width="0" /></Grid.ColumnDefinitions>
              <AutoSuggestBox x:Name="ResultsSearchBox" x:Uid="ResultsSearchBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" MinHeight="36" Margin="0,0,0,8" QueryIcon="Find" TextChanged="OnResultsSearchTextChanged" />
              <ComboBox x:Name="ResultsSortComboBox" x:Uid="ResultsSortComboBox" Grid.Row="1" Grid.Column="0" MinWidth="156" MinHeight="36" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="OnResultsSortChanged"><ComboBoxItem x:Uid="ResultsSortReclaimable" Tag="ReclaimableBytes" /><ComboBoxItem x:Uid="ResultsSortFileSize" Tag="FileSize" /><ComboBoxItem x:Uid="ResultsSortCopies" Tag="CopyCount" /><ComboBoxItem x:Uid="ResultsSortName" Tag="Name" /><ComboBoxItem x:Uid="ResultsSortPath" Tag="Path" /></ComboBox>
              <Button x:Name="ResultsDirectionButton" x:Uid="ResultsDescendingButton" Grid.Row="1" Grid.Column="1" MinHeight="36" Margin="0,0,8,0" Click="OnResultsDirectionClick" Style="{StaticResource ToolbarButtonStyle}" />
              <ComboBox x:Name="ResultsFilterComboBox" x:Uid="ResultsFilterComboBox" Grid.Row="1" Grid.Column="2" MinWidth="150" MinHeight="36" SelectedIndex="0" SelectionChanged="OnResultsFilterChanged"><ComboBoxItem x:Uid="ResultsFilterAll" Tag="AllGroups" /><ComboBoxItem x:Uid="ResultsFilterSelected" Tag="SelectedGroups" /></ComboBox>
              <StackPanel x:Name="ResultsExpandPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button x:Uid="ExpandAllButton" Click="OnExpandAllClick" Style="{StaticResource ToolbarButtonStyle}" /><Button x:Uid="CollapseAllButton" Click="OnCollapseAllClick" Style="{StaticResource ToolbarButtonStyle}" /></StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="4" Style="{StaticResource SurfaceBorderStyle}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Border Padding="14,9" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="96" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions><TextBlock x:Uid="ResultsGroupsLabel" Style="{StaticResource BodyStrongTextStyle}" /><TextBlock x:Uid="GroupCopiesLabel" Grid.Column="1" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Uid="GroupSizeLabel" Grid.Column="2" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Uid="GroupReclaimableLabel" Grid.Column="3" Style="{StaticResource MetricLabelTextStyle}" /></Grid></Border>
              <ListView x:Name="ResultsGroupsList" x:Uid="ResultsGroupsList" Grid.Row="1" HorizontalContentAlignment="Stretch" IsTabStop="False" ItemContainerStyle="{StaticResource CompactListViewItemStyle}" ItemsSource="{Binding VisibleGroups}" SelectionMode="None">
