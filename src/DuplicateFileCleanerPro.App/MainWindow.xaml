<Window x:Class="DuplicateFileCleanerPro.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls" xmlns:results="using:DuplicateFileCleanerPro.App.Results">
  <controls:NavigationView x:Name="ShellNavigation" PaneDisplayMode="Left" OpenPaneLength="224" CompactPaneLength="48" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <controls:NavigationView.MenuItems>
      <controls:NavigationViewItem x:Name="ScanNavigationItem" x:Uid="ScanNavigationItem" Icon="Find" IsSelected="True" MinHeight="40" Padding="12,0" />
      <controls:NavigationViewItem x:Name="ResultsNavigationItem" x:Uid="ResultsNavigationItem" Icon="Bullets" IsEnabled="False" MinHeight="40" Padding="12,0" />
      <controls:NavigationViewItem x:Name="SettingsNavigationItem" x:Uid="SettingsNavigationItem" Icon="Setting" MinHeight="40" Padding="12,0" />
    </controls:NavigationView.MenuItems>
    <Grid Padding="{StaticResource PagePadding}">
      <ScrollViewer x:Name="ScanScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid>
          <StackPanel x:Name="ScanPage" MaxWidth="1000">
            <Grid ColumnSpacing="20" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock x:Uid="ScanSetupTitle" Style="{StaticResource PageTitleTextStyle}"/><TextBlock x:Uid="ScanSetupDescription" Opacity="0.7"/></StackPanel><Button x:Name="StartScanButton" x:Uid="StartScanButton" Grid.Column="1" VerticalAlignment="Center" Click="OnStartScanClick"/></Grid>
            <TextBlock x:Uid="ScanLocationsTitle" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8"/>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="16,12"><StackPanel Spacing="10"><TextBlock x:Name="ScanLocationsEmptyText" x:Uid="ScanLocationsEmpty" Opacity="0.7"/><ListView x:Name="LocationsList" SelectionMode="None" Visibility="Collapsed"><ListView.ItemTemplate><DataTemplate><Grid Padding="0,7" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8B7;" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding NormalizedPath}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding NormalizedPath}"/></StackPanel><Button Grid.Column="2" x:Uid="RemoveFolderButton" Tag="{Binding}" Click="OnRemoveFolderClick"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><Button x:Uid="AddFolderButton" HorizontalAlignment="Left" Click="OnAddFolderClick"/></StackPanel></Border>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="16,14" Margin="0,16,0,0"><StackPanel Spacing="5"><TextBlock x:Uid="ReviewTitle" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock x:Name="ReviewSummaryText" x:Uid="ReviewDescription" Opacity="0.75" TextWrapping="Wrap"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="ScanningPage" Visibility="Collapsed" MaxWidth="1000"><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock x:Name="ScanStageTitle" x:Uid="ScanningTitle" Style="{StaticResource PageTitleTextStyle}"/><TextBlock x:Name="ScanStageDescription" x:Uid="ScanningDescription" Opacity="0.7"/></StackPanel><Button x:Name="CancelScanButton" x:Uid="CancelScanButton" Grid.Column="1" VerticalAlignment="Center" Click="OnCancelScanClick"/></Grid><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="18,16"><StackPanel Spacing="12"><ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True" Height="6"/><TextBlock x:Name="CurrentActivityText" x:Uid="ScanningWaiting" TextTrimming="CharacterEllipsis"/><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Uid="MetricFiles" Opacity="0.65" FontSize="12"/><TextBlock x:Name="FilesMetricText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Uid="MetricAnalyzed" Opacity="0.65" FontSize="12"/><TextBlock x:Name="AnalyzedMetricText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Uid="MetricGroups" Opacity="0.65" FontSize="12"/><TextBlock x:Name="GroupsMetricText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Uid="MetricElapsed" Opacity="0.65" FontSize="12"/><TextBlock x:Name="ElapsedMetricText" FontWeight="SemiBold"/></StackPanel></Grid></StackPanel></Border></StackPanel>
          <StackPanel x:Name="SettingsPage" Visibility="Collapsed" MaxWidth="880"><TextBlock x:Uid="SettingsTitle" Style="{StaticResource PageTitleTextStyle}"/><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0"><StackPanel Spacing="4"><TextBlock x:Uid="SettingsSectionTitle" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock x:Uid="SettingsDescription" Opacity="0.7"/></StackPanel></Border></StackPanel>
        </Grid>
      </ScrollViewer>
      <Grid x:Name="ResultsPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="16" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Uid="ResultsTitle" Style="{StaticResource PageTitleTextStyle}"/><TextBlock x:Uid="ResultsDescription" Opacity="0.7"/></StackPanel><Button x:Uid="ResultsNewScanButton" Grid.Column="1" VerticalAlignment="Center" Click="OnNewScanClick" /></Grid>
        <Grid Grid.Row="1" ColumnSpacing="24" Padding="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Uid="ResultsGroupsLabel" Opacity="0.65" FontSize="12"/><TextBlock x:Name="ResultGroupsText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Uid="ResultsFilesLabel" Opacity="0.65" FontSize="12"/><TextBlock x:Name="ResultFilesText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Uid="ResultsReclaimableLabel" Opacity="0.65" FontSize="12"/><TextBlock x:Name="ResultReclaimableText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Uid="ResultsCandidatesLabel" Opacity="0.65" FontSize="12"/><TextBlock x:Name="ResultCandidatesText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="4" HorizontalAlignment="Right"><TextBlock x:Uid="ResultsSkippedLabel" Opacity="0.65" FontSize="12"/><TextBlock x:Name="ResultSkippedText" FontWeight="SemiBold" HorizontalAlignment="Right"/></StackPanel></Grid>
        <Grid Grid.Row="2" ColumnSpacing="8" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><AutoSuggestBox x:Name="ResultsSearchBox" x:Uid="ResultsSearchBox" TextChanged="OnResultsSearchTextChanged" QueryIcon="Find"/><ComboBox x:Name="ResultsSortComboBox" x:Uid="ResultsSortComboBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnResultsSortChanged"><ComboBoxItem x:Uid="ResultsSortReclaimable" Tag="ReclaimableBytes"/><ComboBoxItem x:Uid="ResultsSortFileSize" Tag="FileSize"/><ComboBoxItem x:Uid="ResultsSortCopies" Tag="CopyCount"/><ComboBoxItem x:Uid="ResultsSortName" Tag="Name"/><ComboBoxItem x:Uid="ResultsSortPath" Tag="Path"/></ComboBox><Button x:Name="ResultsDirectionButton" x:Uid="ResultsDescendingButton" Grid.Column="2" Click="OnResultsDirectionClick"/><ComboBox x:Name="ResultsFilterComboBox" x:Uid="ResultsFilterComboBox" Grid.Column="3" SelectedIndex="0" SelectionChanged="OnResultsFilterChanged"><ComboBoxItem x:Uid="ResultsFilterAll" Tag="AllGroups"/><ComboBoxItem x:Uid="ResultsFilterSelected" Tag="SelectedGroups"/></ComboBox><StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button x:Uid="ExpandAllButton" Click="OnExpandAllClick"/><Button x:Uid="CollapseAllButton" Click="OnCollapseAllClick"/></StackPanel></Grid>
        <Grid Grid.Row="3"><ListView x:Name="ResultsGroupsList" x:Uid="ResultsGroupsList" ItemsSource="{Binding VisibleGroups}" SelectionMode="None" HorizontalContentAlignment="Stretch"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemTemplate><DataTemplate x:DataType="results:ResultGroupViewModel"><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10"><controls:Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch"><controls:Expander.Header><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Representative.File.NormalizedPath}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Representative.File.NormalizedPath}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Uid="GroupCopiesLabel" FontSize="12" Opacity="0.65"/><TextBlock Text="{Binding Members.Count}" HorizontalAlignment="Right"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Uid="GroupSizeLabel" FontSize="12" Opacity="0.65"/><TextBlock Text="{Binding FileSize, Converter={StaticResource ByteSizeConverter}}" HorizontalAlignment="Right"/></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Uid="GroupReclaimableLabel" FontSize="12" Opacity="0.65"/><TextBlock Text="{Binding ReclaimableBytes, Converter={StaticResource ByteSizeConverter}}" FontWeight="SemiBold" HorizontalAlignment="Right"/></StackPanel></Grid></controls:Expander.Header><ListView x:Uid="ResultsMembersList" ItemsSource="{Binding Members}" SelectionMode="None" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate x:DataType="results:ResultMemberViewModel"><Grid Padding="32,8,4,8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Uid="ResultsCandidateCheckBox" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding File.FileName}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding File.NormalizedPath}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding File.NormalizedPath}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding File.Length, Converter={StaticResource ByteSizeConverter}}" VerticalAlignment="Center" Opacity="0.8"/><TextBlock Grid.Column="3" Text="{Binding File.LastWriteTimeUtc, Converter={StaticResource DateTimeConverter}}" VerticalAlignment="Center" FontSize="12" Opacity="0.65"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></controls:Expander></Border></DataTemplate></ListView.ItemTemplate></ListView><StackPanel x:Name="ResultsEmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Visibility="Collapsed"><TextBlock x:Name="ResultsEmptyTitle" Style="{StaticResource SectionTitleTextStyle}" HorizontalAlignment="Center"/><TextBlock x:Name="ResultsEmptyDescription" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel></Grid>
      </Grid>
    </Grid>
  </controls:NavigationView>
</Window>
