                <ListView.ItemTemplate><DataTemplate x:DataType="results:ResultGroupViewModel"><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><controls:Expander HorizontalAlignment="Stretch" AutomationProperties.HelpText="{Binding Representative.File.NormalizedPath}" AutomationProperties.Name="{Binding DisplayName}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                  <controls:Expander.Header><Grid MinHeight="52" Padding="4,4,12,4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="96" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="1"><TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextStyle}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Representative.File.NormalizedPath}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding Representative.File.NormalizedPath}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Members.Count}" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding FileSize, Converter={StaticResource ByteSizeConverter}}" /><TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ReclaimableBytes, Converter={StaticResource ByteSizeConverter}}" /></Grid></controls:Expander.Header>
                  <ListView x:Uid="ResultsMembersList" HorizontalContentAlignment="Stretch" IsTabStop="False" ItemContainerStyle="{StaticResource CompactListViewItemStyle}" ItemsSource="{Binding Members}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="results:ResultMemberViewModel"><Grid MinHeight="50" Padding="38,5,12,5" Background="{ThemeResource SubtleFillColorTransparentBrush}" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><CheckBox Width="32" MinWidth="32" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.HelpText="{Binding AccessiblePath}" AutomationProperties.Name="{Binding AccessibleName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" /><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"><TextBlock Text="{Binding File.FileName}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding File.NormalizedPath}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding File.NormalizedPath}" /></StackPanel><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding File.Length, Converter={StaticResource ByteSizeConverter}}" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding File.LastWriteTimeUtc, Converter={StaticResource DateTimeConverter}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="NoWrap" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                </controls:Expander></Border></DataTemplate></ListView.ItemTemplate>
              </ListView>
              <StackPanel x:Name="ResultsEmptyPanel" Grid.Row="1" MinHeight="220" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5" Visibility="Collapsed"><FontIcon HorizontalAlignment="Center" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE9D9;" /><TextBlock x:Name="ResultsEmptyTitle" HorizontalAlignment="Center" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock x:Name="ResultsEmptyDescription" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource PageSubtitleTextStyle}" /></StackPanel>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="CleanupPage" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,14" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Name="CleanupPageTitle" Style="{StaticResource PageTitleTextStyle}" /><TextBlock x:Name="CleanupPageDescription" Style="{StaticResource PageSubtitleTextStyle}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8"><Button x:Name="CleanupBackButton" x:Uid="CleanupBackButton" MinHeight="36" Click="OnCleanupBackClick" Style="{StaticResource ToolbarButtonStyle}" /><Button x:Name="CleanupRescanButton" x:Uid="CleanupRescanButton" MinHeight="36" Click="OnCleanupRescanClick" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" /></StackPanel></Grid>
          <ScrollViewer Grid.Row="1" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><Grid>
            <StackPanel x:Name="CleanupReviewPanel" Spacing="12">
              <Border Padding="16,12" Style="{StaticResource SurfaceBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Padding="0,0,14,0"><TextBlock x:Uid="CleanupCandidateFilesLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="CleanupCandidateFilesText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" /><StackPanel Grid.Column="2" Padding="14,0"><TextBlock x:Uid="CleanupCandidateSpaceLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="CleanupCandidateSpaceText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="3" Fill="{ThemeResource CardStrokeColorDefaultBrush}" /><StackPanel Grid.Column="4" Padding="14,0,0,0"><TextBlock x:Uid="CleanupAffectedGroupsLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="CleanupAffectedGroupsText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel></Grid></Border>
              <TextBlock x:Uid="CleanupReviewSummaryTitle" Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" /><TextBlock x:Name="CleanupReviewSummaryText" Margin="0,-8,0,0" Style="{StaticResource PageSubtitleTextStyle}" />
              <Border Style="{StaticResource SurfaceBorderStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Padding="14,9" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="108" /></Grid.ColumnDefinitions><TextBlock x:Uid="CleanupGroupHeader" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Uid="CleanupFileHeader" Grid.Column="1" Style="{StaticResource BodyStrongTextStyle}" /><TextBlock x:Uid="GroupSizeLabel" Grid.Column="2" Style="{StaticResource MetricLabelTextStyle}" /></Grid>
                <ListView x:Name="CleanupReviewList" x:Uid="CleanupReviewList" Grid.Row="1" MaxHeight="330" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource CompactListViewItemStyle}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="cleanup:CleanupReviewCandidate"><Grid MinHeight="52" Padding="14,6" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="108" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{Binding GroupNumber}" Style="{StaticResource SecondaryTextStyle}" /><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"><TextBlock Text="{Binding File.FileName}" Style="{StaticResource BodyStrongTextStyle}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding File.NormalizedPath}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding File.NormalizedPath}" /></StackPanel><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding File.Length, Converter={StaticResource ByteSizeConverter}}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
              </Grid></Border>
              <InfoBar x:Uid="CleanupRecycleBinNotice" IsClosable="False" IsOpen="True" Severity="Informational" />
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button x:Uid="CleanupChangeSelectionButton" Click="OnCleanupBackClick" Style="{StaticResource ToolbarButtonStyle}" /><Button x:Name="ConfirmCleanupButton" x:Uid="ConfirmCleanupButton" Click="OnConfirmCleanupClick" Style="{StaticResource AccentButtonStyle}" /></StackPanel>
            </StackPanel>
            <StackPanel x:Name="CleanupProgressPanel" Spacing="14" Visibility="Collapsed"><Border Padding="20" Style="{StaticResource SurfaceBorderStyle}"><StackPanel Spacing="16"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ProgressRing Width="32" Height="32" IsActive="True" /><TextBlock x:Name="CleanupActivityText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></Grid><ProgressBar x:Name="CleanupProgressBar" Height="5" Minimum="0" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Padding="0,0,14,0"><TextBlock x:Uid="CleanupProcessedLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="CleanupProcessedText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" /><StackPanel Grid.Column="2" Padding="14,0"><TextBlock x:Uid="CleanupMovedLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="CleanupMovedText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="3" Fill="{ThemeResource CardStrokeColorDefaultBrush}" /><StackPanel Grid.Column="4" Padding="14,0"><TextBlock x:Uid="CleanupSkippedLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="CleanupSkippedText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="5" Fill="{ThemeResource CardStrokeColorDefaultBrush}" /><StackPanel Grid.Column="6" Padding="14,0,0,0"><TextBlock x:Uid="CleanupReclaimedLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="CleanupReclaimedText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel></Grid><Button x:Name="CancelCleanupButton" x:Uid="CancelCleanupButton" HorizontalAlignment="Left" Click="OnCancelCleanupClick" Style="{StaticResource ToolbarButtonStyle}" /></StackPanel></Border></StackPanel>
            <StackPanel x:Name="CleanupCompletionPanel" Spacing="14" Visibility="Collapsed"><Border Padding="20" Style="{StaticResource SurfaceBorderStyle}"><StackPanel Spacing="12"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontSize="26" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE73E;" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="CleanupCompletionTitle" Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" /><TextBlock x:Name="CleanupCompletionSummary" Style="{StaticResource PageSubtitleTextStyle}" /></StackPanel></Grid><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Padding="0,0,14,0"><TextBlock x:Uid="CleanupMovedLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="CleanupCompletionMovedText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" /><StackPanel Grid.Column="2" Padding="14,0"><TextBlock x:Uid="CleanupReclaimedLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="CleanupCompletionReclaimedText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="3" Fill="{ThemeResource CardStrokeColorDefaultBrush}" /><StackPanel Grid.Column="4" Padding="14,0"><TextBlock x:Uid="CleanupSkippedLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="CleanupCompletionSkippedText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel><Rectangle Grid.Column="5" Fill="{ThemeResource CardStrokeColorDefaultBrush}" /><StackPanel Grid.Column="6" Padding="14,0,0,0"><TextBlock x:Uid="CleanupFailedLabel" Style="{StaticResource MetricLabelTextStyle}" /><TextBlock x:Name="CleanupCompletionFailedText" Style="{StaticResource MetricValueTextStyle}" /></StackPanel></Grid></StackPanel></Border><TextBlock x:Name="CleanupOutcomesTitle" x:Uid="CleanupOutcomesTitle" Style="{StaticResource SectionTitleTextStyle}" Visibility="Collapsed" /><Border Style="{StaticResource SurfaceBorderStyle}"><ListView x:Name="CleanupOutcomeList" x:Uid="CleanupOutcomeList" MaxHeight="300" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource CompactListViewItemStyle}" SelectionMode="None" Visibility="Collapsed"><ListView.ItemTemplate><DataTemplate><Grid MinHeight="54" Padding="14,7" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="1"><TextBlock Text="{Binding FileName}" Style="{StaticResource BodyStrongTextStyle}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /><TextBlock Text="{Binding Path}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding Path}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Size, Converter={StaticResource ByteSizeConverter}}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border></StackPanel>
          </Grid></ScrollViewer>
        </Grid>
      </Grid>
    </controls:NavigationView>
  </Grid>
</Window>
