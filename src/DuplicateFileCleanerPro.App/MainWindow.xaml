<Window x:Class="DuplicateFileCleanerPro.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls">
  <controls:NavigationView x:Name="ShellNavigation" PaneDisplayMode="Left" OpenPaneLength="224" CompactPaneLength="48" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <controls:NavigationView.MenuItems><controls:NavigationViewItem x:Name="ScanNavigationItem" x:Uid="ScanNavigationItem" Icon="Find" IsSelected="True" MinHeight="40" Padding="12,0"/><controls:NavigationViewItem x:Name="SettingsNavigationItem" x:Uid="SettingsNavigationItem" Icon="Setting" MinHeight="40" Padding="12,0"/></controls:NavigationView.MenuItems>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><Grid Padding="{StaticResource PagePadding}">
      <StackPanel x:Name="ScanPage" MaxWidth="1000"><Grid ColumnSpacing="20" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock x:Uid="ScanSetupTitle" Style="{StaticResource PageTitleTextStyle}"/><TextBlock x:Uid="ScanSetupDescription" Opacity="0.7"/></StackPanel><Button x:Name="StartScanButton" x:Uid="StartScanButton" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" Click="OnStartScanClick"/></Grid><TextBlock x:Uid="ScanLocationsTitle" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8"/><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="16,12"><StackPanel Spacing="10"><TextBlock x:Name="ScanLocationsEmptyText" x:Uid="ScanLocationsEmpty" Opacity="0.7"/><ListView x:Name="LocationsList" SelectionMode="None" Visibility="Collapsed"><ListView.ItemTemplate><DataTemplate><Grid Padding="0,7" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8B7;" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding NormalizedPath}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding NormalizedPath}"/></StackPanel><Button Grid.Column="2" x:Uid="RemoveFolderButton" Tag="{Binding}" Click="OnRemoveFolderClick"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><Button x:Uid="AddFolderButton" HorizontalAlignment="Left" Click="OnAddFolderClick"/></StackPanel></Border><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="16,14" Margin="0,16,0,0"><StackPanel Spacing="5"><TextBlock x:Uid="ReviewTitle" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock x:Name="ReviewSummaryText" x:Uid="ReviewDescription" Opacity="0.75" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
      <StackPanel x:Name="ScanningPage" Visibility="Collapsed" MaxWidth="1000"><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock x:Name="ScanStageTitle" x:Uid="ScanningTitle" Style="{StaticResource PageTitleTextStyle}"/><TextBlock x:Name="ScanStageDescription" x:Uid="ScanningDescription" Opacity="0.7"/></StackPanel><Button x:Name="CancelScanButton" x:Uid="CancelScanButton" Grid.Column="1" VerticalAlignment="Center" Click="OnCancelScanClick"/></Grid><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="18,16"><StackPanel Spacing="12"><ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True" Height="6"/><TextBlock x:Name="CurrentActivityText" x:Uid="ScanningWaiting" TextTrimming="CharacterEllipsis"/><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Uid="MetricFiles" Opacity="0.65" FontSize="12"/><TextBlock x:Name="FilesMetricText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Uid="MetricAnalyzed" Opacity="0.65" FontSize="12"/><TextBlock x:Name="AnalyzedMetricText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Uid="MetricGroups" Opacity="0.65" FontSize="12"/><TextBlock x:Name="GroupsMetricText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Uid="MetricElapsed" Opacity="0.65" FontSize="12"/><TextBlock x:Name="ElapsedMetricText" FontWeight="SemiBold"/></StackPanel></Grid></StackPanel></Border></StackPanel>
      <StackPanel x:Name="CompletedPage" Visibility="Collapsed" MaxWidth="1000"><TextBlock x:Uid="CompletedTitle" Style="{StaticResource PageTitleTextStyle}"/><TextBlock x:Uid="CompletedDescription" Opacity="0.7" Margin="0,6,0,20"/><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceCornerRadius}" Padding="18,16"><StackPanel Spacing="8"><TextBlock x:Name="CompletionSummaryText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CompletionDetailText" Opacity="0.7" TextWrapping="Wrap"/><Button x:Uid="NewScanButton" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnNewScanClick"/></StackPanel></Border></StackPanel>
      <StackPanel x:Name="SettingsPage" Visibility="Collapsed" MaxWidth="880"><TextBlock x:Uid="SettingsTitle" Style="{StaticResource PageTitleTextStyle}"/><Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0"><StackPanel Spacing="4"><TextBlock x:Uid="SettingsSectionTitle" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock x:Uid="SettingsDescription" Opacity="0.7"/></StackPanel></Border></StackPanel>
    </Grid></ScrollViewer>
  </controls:NavigationView>
</Window>
