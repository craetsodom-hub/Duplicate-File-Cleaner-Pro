<Application
    x:Class="DuplicateFileCleanerPro.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:results="using:DuplicateFileCleanerPro.App.Results">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="Resources/VisualResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <results:ByteSizeConverter x:Key="ByteSizeConverter" />
      <results:DateTimeConverter x:Key="DateTimeConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
